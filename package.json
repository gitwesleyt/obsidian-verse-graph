{
	"name": "obsidian-verse-graph",
	"version": "0.6.0",
	"description": "Obsidian plugin that draws the Bible verses your notes cite as a graph.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -p tsconfig.build.json -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest run",
		"check": "npm run build && npm run lint && npm test",
		"release": "npm run check && git push --follow-tags",
		"test-vault": "npm run build && node scripts/make-test-vault.mjs",
		"big-vault": "npm run build && node scripts/make-big-vault.mjs",
		"compare-app": "node scripts/compare-app.mjs"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^7.3.6",
		"vitest": "^5.0.2"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	},
	"dependencies": {
		"@panzoom/panzoom": "^4.6.2"
	}
}
